<?xml version="1.0"?>
<Container version="2">
    <Name>syncstorage-rs</Name>
    <Repository>ghcr.io/mozilla-services/syncstorage-rs/syncstorage-rs-mysql:ab47abaaed</Repository>
    <Registry>https://github.com/mozilla-services/syncstorage-rs/pkgs/container/syncstorage-rs%2Fsyncstorage-rs-mysql</Registry>
    <Network>bridge</Network>
    <Privileged>false</Privileged>
    <Support>https://github.com/mozilla-services/syncstorage-rs/issues</Support>
    <Project>https://github.com/mozilla-services/syncstorage-rs</Project>
    <Overview>Self-hosted Firefox Sync (syncstorage-rs) server, backed by an existing external MariaDB/MySQL instance. Note: images are tagged by commit SHA, not latest/semver - check the Registry link periodically for a newer tag.</Overview>
    <Category>Network:Other</Category>
    <WebUI></WebUI>
    <Icon></Icon>
    <ExtraParams>--platform=linux/amd64</ExtraParams>
    <DateInstalled></DateInstalled>

    <Config Name="Sync Port" Target="8000" Default="8000" Mode="tcp" Description="Port clients connect to" Type="Port" Display="always" Required="true" Mask="false">8000</Config>

    <Config Name="SYNC_MASTER_SECRET" Target="SYNC_MASTER_SECRET" Default="" Mode="" Description="64-char random secret. Generate with: cat /dev/urandom | tr -dc 'A-Za-z0-9' | head -c 64" Type="Variable" Display="always" Required="true" Mask="true"></Config>

    <Config Name="SYNC_SYNCSTORAGE__DATABASE_URL" Target="SYNC_SYNCSTORAGE__DATABASE_URL" Default="" Mode="" Description="mysql://sync:PASSWORD@YOUR_MARIADB_HOST:3306/syncstorage_rs" Type="Variable" Display="always" Required="true" Mask="true"></Config>

    <Config Name="SYNC_TOKENSERVER__DATABASE_URL" Target="SYNC_TOKENSERVER__DATABASE_URL" Default="" Mode="" Description="mysql://sync:PASSWORD@YOUR_MARIADB_HOST:3306/tokenserver_rs" Type="Variable" Display="always" Required="true" Mask="true"></Config>

    <Config Name="SYNC_TOKENSERVER__INIT_NODE_URL" Target="SYNC_TOKENSERVER__INIT_NODE_URL" Default="" Mode="" Description="Public URL clients use to reach this server, e.g. http://192.168.1.50:8000" Type="Variable" Display="always" Required="true" Mask="false"></Config>

    <Config Name="SYNC_HOST" Target="SYNC_HOST" Default="0.0.0.0" Mode="" Description="Bind address inside the container" Type="Variable" Display="advanced" Required="true" Mask="false">0.0.0.0</Config>

    <Config Name="SYNC_PORT" Target="SYNC_PORT" Default="8000" Mode="" Description="Internal listen port, should match the Port mapping above" Type="Variable" Display="advanced" Required="true" Mask="false">8000</Config>

    <Config Name="SYNC_TOKENSERVER__ENABLED" Target="SYNC_TOKENSERVER__ENABLED" Default="true" Mode="" Description="Enable the tokenserver component" Type="Variable" Display="advanced" Required="true" Mask="false">true</Config>

    <Config Name="SYNC_TOKENSERVER__NODE_TYPE" Target="SYNC_TOKENSERVER__NODE_TYPE" Default="mysql" Mode="" Description="Tokenserver backend type" Type="Variable" Display="advanced" Required="true" Mask="false">mysql</Config>

    <Config Name="SYNC_TOKENSERVER__RUN_MIGRATIONS" Target="SYNC_TOKENSERVER__RUN_MIGRATIONS" Default="true" Mode="" Description="Auto-run DB schema migrations against your existing MariaDB on startup" Type="Variable" Display="advanced" Required="true" Mask="false">true</Config>

    <Config Name="SYNC_TOKENSERVER__FXA_EMAIL_DOMAIN" Target="SYNC_TOKENSERVER__FXA_EMAIL_DOMAIN" Default="api.accounts.firefox.com" Mode="" Description="Firefox Accounts email domain (auth still goes through Mozilla FxA)" Type="Variable" Display="advanced" Required="false" Mask="false">api.accounts.firefox.com</Config>

    <Config Name="SYNC_TOKENSERVER__FXA_OAUTH_SERVER_URL" Target="SYNC_TOKENSERVER__FXA_OAUTH_SERVER_URL" Default="https://oauth.accounts.firefox.com" Mode="" Description="Firefox Accounts OAuth server URL" Type="Variable" Display="advanced" Required="false" Mask="false">https://oauth.accounts.firefox.com</Config>

    <Config Name="SYNC_HUMAN_LOGS" Target="SYNC_HUMAN_LOGS" Default="false" Mode="" Description="Human-readable (vs JSON) logs" Type="Variable" Display="advanced" Required="false" Mask="false">false</Config>

    <Config Name="RUST_LOG" Target="RUST_LOG" Default="info" Mode="" Description="Log verbosity" Type="Variable" Display="advanced" Required="false" Mask="false">info</Config>
</Container>
